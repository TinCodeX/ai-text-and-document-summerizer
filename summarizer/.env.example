# ==============================================================================
# AI Document & Text Summarizer - Environment Configuration
# ==============================================================================
# Copy this file to .env and populate your actual API key(s)
# Example: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# Active LLM Provider: 'gemini' (recommended) or 'openai'
LLM_PROVIDER=gemini

# --- Google Gemini Settings ---
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI Settings (Optional / Alternative) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection (Defaults to high-speed, cost-effective flash/mini tier)
# For Gemini: gemini-2.0-flash or gemini-1.5-flash
# For OpenAI: gpt-4o-mini
LLM_MODEL=gemini-2.0-flash

# Generation Parameters
# Temperature: 0.0 - 2.0 (Lower values like 0.2 ensure factual, deterministic summaries)
TEMPERATURE=0.2
